{
  "name": "csv2xlsx",
  "version": "1.0.0",
  "description": "Convert CSV files to Excel (.xlsx) from the command line, with a progress bar.",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "csv2xlsx": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:bdd": "node --import tsx node_modules/@cucumber/cucumber/bin/cucumber.js",
    "test:all": "npm run typecheck && npm test && npm run test:bdd",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "csv",
    "excel",
    "xlsx",
    "cli",
    "converter"
  ],
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
