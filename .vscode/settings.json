{
  "python.defaultInterpreterPath": "${workspaceFolder}/src/python/.venv",
  "python.testing.pytestEnabled": true,
  "python.testing.cwd": "${workspaceFolder}/src/python",
  "python.testing.pytestArgs": ["tests"],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true
  },
  "cucumber.features": ["src/*/features/**/*.feature"],
  "cucumber.glue": [
    "src/typescript/features/step_definitions/**/*.ts",
    "src/python/features/steps/**/*.py"
  ],
  "typescript.tsdk": "src/typescript/node_modules/typescript/lib"
}
